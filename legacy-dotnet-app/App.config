<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <add key="LibraryApiUrl" value="http://127.0.0.1:8000/books" />
        <add key="ReportExportPath" value="reports\catalog_summary.txt" />
        <add key="MaxRetries" value="3" />
    </appSettings>
</configuration>
